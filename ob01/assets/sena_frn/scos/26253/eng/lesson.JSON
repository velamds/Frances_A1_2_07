e": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn3le07ob01re2img01.jpg"}, {"text": "<span class =\"strong\">M. Tremblay</span> : Je vais commencer la r\u00e9union maintenant. Nous allons commencer avec les pr\u00e9sentations en table ronde. Veuillez vous pr\u00e9senter \u00e0 tour de r\u00f4le. Je m'appelle Fr\u00e9d\u00e9ric Tremblay. Je suis le pr\u00e9sident de MechaTech. Je vous pr\u00e9sente Daniel Laroche,  le pr\u00e9sident de la r\u00e9union aujourd'hui.<br />\n<span class =\"strong\">M. Laroche</span> : Bonjour.<br /><span class =\"strong\">Mme Marchant</span> :  Salut, je m'appelle Carole Marchant. Je suis vice-pr\u00e9sidente.<br />", "id": 1, "time": "100", "image": "frn3le07ob01re2img01.jpg"}, {"text": "<span class =\"strong\">Pierre</span> : Bonjour, je m'appelle Pierre. Je suis stagiaire. J'ai h\u00e2te de participer \u00e0 votre r\u00e9union.", "id": 2, "time": "20000", "image": "frn3le07ob01re2img05.jpg"}, {"text": "<span class =\"strong\">Mme Leroux</span> :  Je m'appelle Suzanne Leroux, g\u00e9rante du service des ressources humaines. <br /><span class =\"strong\">Mme Marchant</span> : Quel est votre r\u00f4le, Suzanne ?<br /><span class =\"strong\">Suzanne</span> : Je vais faire la r\u00e9partition des t\u00e2ches.<br /><span class =\"strong\">M. Tremblay</span> :  Bien, on va commencer. <br /><span class =\"strong\">M. Laroche</span> :  Les points \u00e0 l'ordre du jour sont : les objectifs du projet de logiciel, les am\u00e9liorations \u00e0 la salle du conseil et le rapport du stagiaire.", "id": 3, "time": "26000", "image": "frn3le07ob01re2img02.jpg"}], "audiosrc": "frn3le07ob01re2aud01", "coverimg": "frn3le07ob01re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}